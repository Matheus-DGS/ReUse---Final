{
  "name": "reuse-api",
  "version": "3.0.0",
  "private": true,
  "description": "ReUse! — API REST (Node.js + Express + Prisma + PostgreSQL): autenticação, catálogo, pontos de coleta, gamificação, assistente Eco e área administrativa.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "prisma generate && prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "assistente:gerar": "tsx watson/gerar-skill.ts",
    "assistente:testar": "tsx scripts/testar-assistente.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "6.19.3",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
