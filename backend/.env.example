# ---------------------------------------------------------------------------
# Backend ReUse! (Node.js + Express + Prisma)
# ---------------------------------------------------------------------------

# Conexão com o PostgreSQL (local, Neon, Supabase, Render...)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/reuse?schema=public"
# Conexão direta, sem pooler, usada pelas migrations (em banco local, repita a mesma URL)
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5432/reuse?schema=public"

# Chave usada para assinar o token JWT da sessão (gere uma string longa e aleatória)
JWT_SECRET="troque-esta-chave-por-uma-string-aleatoria-e-secreta"

# Porta do servidor (o Render injeta a dele automaticamente)
PORT=4000

# Origens autorizadas a chamar a API, separadas por vírgula.
# Em produção, coloque a URL do frontend na Vercel.
ORIGENS_PERMITIDAS="http://localhost:3000"

# IBM watsonx Assistant (assistente Eco).
# Sem essas variáveis, a API usa o motor local que interpreta a MESMA skill.
WATSON_APIKEY=""
WATSON_URL="https://api.us-south.assistant.watson.cloud.ibm.com/instances/SEU-ID-DE-INSTANCIA"
WATSON_ENVIRONMENT_ID=""
